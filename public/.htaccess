<IfModule mod_rewrite.c>
    # (необязательно) убираем лишнее
    Options -Indexes

    RewriteEngine On

    # -------- 1) Канонический хост (сохраняем путь!) --------
    RewriteCond %{HTTP_HOST} !^(www\.)?truckmobilerepair\.contact$ [NC]
    RewriteRule ^ https://truckmobilerepair.contact%{REQUEST_URI} [R=301,L]

    # -------- 2) Трейлинг-слеш: убираем завершающий слеш (кроме каталога и корня) --------
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+?)/$ /$1 [R=301,L]

    # -------- 3) "Чистые" URL для .html --------
    # /about  -> about.html  (отдаём файл)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]

    # /about.html -> /about  (SEO-редирект)
    RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # -------- 4) Фронт-контроллер (в самую последнюю очередь) --------
    # Всё прочее отдаём index.php, но не трогаем существующие файлы/папки и .php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !\.php$ [NC]
    RewriteRule ^ index.php [L]

    # (если нужны прокиды заголовков — верни их сюда выше фронт-контроллера)
    # RewriteCond %{HTTP:Authorization} .
    # RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # RewriteCond %{HTTP:x-xsrf-token} .
    # RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]
</IfModule>