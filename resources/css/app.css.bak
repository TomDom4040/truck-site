@import 'tailwindcss';

@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
@source '../../storage/framework/views/*.php';
@source '../**/*.blade.php';
@source '../**/*.js';

@theme {
  --font-sans: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji',
    'Segoe UI Symbol', 'Noto Color Emoji';
}

/* Narrower side gutters (mobile-first) */
body, main, .content-wrap {
  padding-left: 8px;
  padding-right: 8px;
}

/* Ensure container gutters override utility classes like px-4/px-6 */
.container {
  padding-left: 8px !important;
  padding-right: 8px !important;
}

@media (min-width: 640px) {
  body, main, .content-wrap {
    padding-left: 12px;
    padding-right: 12px;
  }
  .container {
    padding-left: 12px !important;
    padding-right: 12px !important;
  }
}
/* ——— Стиль «как на трейлере» для верхней надписи ——— */
.topbar-title{
  display:inline-block;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  /* адаптивный размер: удобно и на мобилке, и на десктопе */
  font-size: clamp(12px, 2.2vw, 22px);
  line-height: 1.1;

  /* слегка «стенсил/винтаж» эффект без картинок */
  color: #0b2a3a;                      /* тёмно-синий текст по умолчанию */
  text-shadow:
    -0.5px -0.5px 0 rgba(255,255,255,0.6),
     0.5px  0.5px 0 rgba(0,0,0,0.08);

  /* имитация «потёртости» малозаметным градиентом */
  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(0,0,0,0.08));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: currentColor;
}

/* телефон в верхней полосе — компактнее на мобилке */
.topbar-phone{ white-space: nowrap; font-weight: 800; }
@media (max-width: 420px){
  .topbar-inner{ flex-wrap: wrap; gap: 6px; }
  .topbar-phone{ order: 2; font-size: 13px; }
  .topbar-title{ order: 1; width: 100%; text-align: left; }
}

/* ——— Цвет второй полосы (с лейблами) делаем через переменную ——— */
:root{
  --band-bg: #e9eef2;   /* нейтрально-серый по умолчанию вместо синего */
  --band-text: #0f2530; /* тёмный текст для контраста */
}
.services-bar{
  background: var(--band-bg);
  color: var(--band-text);
}
.service-icon{
  border-color: rgba(15,37,48,0.25);
  background: rgba(255,255,255,0.35);
}
/* Мобайл по умолчанию: меню-кнопка видна, текстовые пункты скрыты */
.main-nav { display: none; align-items: center; }
.menu-btn { display: inline-block; }

/* десктоп (>=768px): наоборот */
@media (min-width: 768px) {
  .main-nav { display: flex; }
  .menu-btn { display: none; }
}

/* выпадающее меню */
.mobile-menu.open { display: block !important; }

<style>
  .content-row{max-width:1100px;margin:0 auto;padding:0 16px;display:flex;align-items:center}
  .topbar{background:#f4f4f5;color:#1b1b18;font:600 12px/1.2 system-ui;padding:6px 0}
  .topbar .topbar-phone{color:#1b1b18;text-decoration:none}
  .header{position:sticky;top:0;z-index:50;background:#0b63d6;color:#fff}
  .header-inner{height:56px}
  .cta-btn{background:#fff;color:#0b63d6;font-weight:700;padding:8px 14px;border-radius:6px;text-decoration:none}
  .spacer{flex:1}
  .main-nav a{color:#fff;text-decoration:none;font-weight:700;margin:0 14px;letter-spacing:.5px}
  .menu-btn{color:#fff;background:transparent;border:1px solid rgba(255,255,255,.4);padding:6px 10px;border-radius:6px}
  /* mobile menu */
  .mobile-menu{display:none;background:#0b63d6}
  .mobile-menu.open{display:block}
  .mobile-menu-inner{padding:8px 0}
  /* footer */
  .site-footer{margin-top:auto;background:#111;color:#ddd}
  .footer-inner{display:grid;gap:20px;grid-template-columns:repeat(4,minmax(0,1fr));max-width:1100px;margin:0 auto;padding:28px 16px}
  .footer-bottom{border-top:1px solid #222;padding:12px 16px;text-align:center;color:#aaa}
  .footer-title{color:#fff;margin-bottom:8px}
  .footer-list{list-style:none;padding:0;margin:0;line-height:1.7}
  .footer-link{color:#ddd;text-decoration:none}
  @media (max-width:900px){
    .main-nav{display:none}
    .mobile-menu{display:none}
    .header-inner .menu-btn{display:block}
    .footer-inner{grid-template-columns:1fr 1fr}
  }
  @media (max-width:600px){
    .footer-inner{grid-template-columns:1fr}
  }
</style>